{
  "ablVersion": "0.2",
  "application": "mockmate",
  "persona": {
    "role": "interview_coach",
    "style": "adaptive",
    "principles": ["concise", "grounded", "supportive", "evidence_based"]
  },
  "designGoals": [
    "low_setup_friction",
    "low_latency",
    "grounded_answers",
    "provider_portability",
    "privacy_by_default",
    "zero_cost_private_beta_when_possible"
  ],
  "capabilities": {
    "reasoning": {
      "lanes": ["fast", "balanced", "strong", "vision"],
      "preferredModes": ["byok", "managed"],
      "required": true
    },
    "speech": {
      "stt": {
        "live": { "preferredModes": ["managed", "byok", "unavailable"], "fallback": "typed-input" },
        "batch": { "preferredModes": ["managed", "byok", "unavailable"], "fallback": "typed-input" }
      },
      "tts": {
        "streaming": { "preferredModes": ["local", "browser", "managed", "unavailable"], "required": false }
      },
      "turnDetection": { "mode": "vad", "bargeIn": true },
      "hotPath": "media-adapter-direct"
    },
    "knowledge": { "preferredModes": ["local", "managed"], "required": true },
    "persistence": { "preferredModes": ["local", "managed"], "required": true },
    "telemetry": {
      "metrics": [
        "stt_first_partial_ms",
        "stt_final_ms",
        "llm_ttft_ms",
        "tts_ttfa_ms",
        "turn_latency_ms",
        "fallback_count",
        "provider_failure_count"
      ],
      "productIntelligence": {
        "mode": "structured_redacted",
        "optInReplayDefault": false,
        "flows": ["live_interview", "solo_practice", "screen_solve"],
        "funnels": {
          "live_interview": {
            "id": "live_interview",
            "label": "Live Interview Funnel",
            "steps": [
              { "id": "login", "label": "Login / Auth" },
              { "id": "live_setup", "label": "Live Setup" },
              { "id": "preflight_verified", "label": "Preflight Verified" },
              { "id": "live_started", "label": "Live Started" },
              { "id": "first_hint_rendered", "label": "First Answer Rendered" },
              { "id": "live_ended", "label": "Live Completed" }
            ]
          },
          "solo_practice": {
            "id": "solo_practice",
            "label": "Solo Practice Funnel",
            "steps": [
              { "id": "login", "label": "Login / Auth" },
              { "id": "solo_setup", "label": "Solo Setup" },
              { "id": "solo_started", "label": "Solo Started" },
              { "id": "solo_evaluated", "label": "Report Evaluated" }
            ]
          },
          "screen_solve": {
            "id": "screen_solve",
            "label": "F7 Screen Solve Funnel",
            "steps": [
              { "id": "f7_captured", "label": "F7 Captured" },
              { "id": "screen_analyzed", "label": "Screen Analyzed" },
              { "id": "coding_tab_used", "label": "Code/Steps Tab Used" }
            ]
          }
        },
        "adaptivePolicies": {
          "ttftFastLaneThresholdMs": 3200,
          "turnLatencyFastLaneThresholdMs": 6000,
          "earlyAbandonWindowMs": 90000
        },
        "excludedData": [
          "resumes",
          "interview_transcripts",
          "prompts",
          "api_keys",
          "passwords",
          "screenshots",
          "raw_meeting_audio"
        ]
      }
    }
  },
  "routing": {
    "reasoning": {
      "hint": "fast",
      "live_hint": "fast",
      "autocomplete": "fast",
      "interview": "balanced",
      "evaluate": "strong",
      "report": "strong",
      "resume": "strong",
      "career": "strong",
      "screen": "vision",
      "vision": "vision",
      "coding_screen": "vision",
      "default": "balanced"
    }
  },
  "runtime": {
    "transcription": {
      "batch": { "retries": 1, "timeoutMs": 30000, "cooldownMs": 30000 }
    }
  },
  "performance": {
    "principle": "measure_hot_path_stages_not_only_total_request_time",
    "reportPercentiles": [50, 95],
    "asyncOffHotPath": ["persistence", "analytics", "history_enrichment", "noncritical_rag_updates"]
  },
  "policies": {
    "credentials": "never_in_abl",
    "fallback": "graceful",
    "userSetup": "minimal",
    "reasoningExecution": "existing-resilient-core-adapter",
    "noDoubleRetry": true
  }
}
