# Hosted MockMate backend — copy these names into your hosting provider's secret/env UI.
# Never commit real values.
HOST=0.0.0.0
PORT=4000
MOCKMATE_HOSTED=1
TRUST_PROXY_HOPS=1

# Required durable auth/data configuration
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/mockmate
JWT_SECRET=replace-with-at-least-32-random-characters

# Explicit browser origins, comma separated. Native mobile requests may omit Origin.
CORS_ORIGIN=https://app.example.com,https://staging.example.com

# Managed AI — configure at least one LLM provider server-side.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Required for hosted mobile transcription.
DEEPGRAM_API_KEY=

# Optional search/billing integrations.
TAVILY_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=
