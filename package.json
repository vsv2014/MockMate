{
  "name": "mockmate",
  "version": "1.5.5",
  "type": "module",
  "main": "electron/bootstrap-v153.cjs",
  "description": "Real-Time AI Interview Companion — Solo practice + Live overlay for Zoom/Teams/Meet (content protection on Win/macOS; verify share preview)",
  "author": "MockMate",
  "license": "MIT",
  "managedApiBase": "",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently \"node server.js\" \"vite\"",
    "build": "vite build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5174 && electron .\"",
    "electron:dev:nosandbox": "concurrently -k \"vite\" \"wait-on http://localhost:5174 && electron . --no-sandbox\"",
    "electron:win": "vite build && electron-builder --win",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win",
    "server": "node server.js",
    "smoke": "node scripts/smoke.mjs",
    "smoke:api": "node scripts/api-smoke.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify": "node scripts/doctor.mjs && vite build && vitest run",
    "verify:platform": "node scripts/verify-platform-versions.mjs",
    "verify:vite-output": "node scripts/verify-vite-output.mjs",
    "verify:react19": "node scripts/verify-react19.mjs",
    "vite": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:dry-run": "node scripts/check-dry-run-evidence.mjs",
    "soak": "node scripts/soak-metrics.mjs",
    "mobile:start": "npm --prefix mobile start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:verify": "npm --prefix mobile run typecheck && npm --prefix mobile test",
    "verify:vitest5": "node scripts/verify-vitest5.mjs",
    "verify:dev-tooling": "node scripts/verify-dev-tooling.mjs",
    "verify:auth-config": "node scripts/verify-auth-config-majors.mjs"
  },
  "build": {
    "appId": "com.mockmate.app",
    "productName": "MockMate",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "api/**/*",
      "shared/**/*",
      "arch/**/*",
      "backend/**/*",
      "!backend/node_modules/**/*",
      "server.js",
      "server-entry.cjs",
      "setup.html",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/.cache/**/*"
    ],
    "extraFiles": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "MockMate-Setup-${version}.${ext}",
      "signtoolOptions": {
        "publisherName": "MockMate",
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MockMate",
      "uninstallDisplayName": "MockMate ${version}",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": false,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vsv2014",
        "repo": "MockMate"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "MockMate-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "MockMate listens to interview audio to generate real-time answer suggestions.",
        "NSCameraUsageDescription": "MockMate may capture screen content to analyze on-screen questions."
      }
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "artifactName": "MockMate-${version}.${ext}"
    }
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.1.6",
    "@sentry/electron": "^7.20.0",
    "@sentry/node": "^10.76.0",
    "bcryptjs": "3.0.3",
    "cors": "^2.8.5",
    "dotenv": "18.0.5",
    "electron-updater": "6.8.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "mongoose": "^8.24.4",
    "openai": "^6.49.0",
    "pdfjs-dist": "^4.10.38",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wait-on": "9.5.1"
  }
}
